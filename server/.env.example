# GharVault Server Environment Configuration

PORT=5000
NODE_ENV=development

# JWT Secret for Session Authentication
JWT_SECRET=gharvault_jwt_secret_production_key_38f9b1c7e

# MongoDB Atlas (Free Tier M0 cluster connection string)
# Example: mongodb+srv://<username>:<password>@cluster0.mongodb.net/gharvault?retryWrites=true&w=majority
MONGODB_URI=

# Supabase Storage & Auth (Free Tier - Private Buckets with Signed URLs)
# Found in your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_BUCKET_NAME=family-documents

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173
